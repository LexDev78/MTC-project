# Copier en `ml/.env` (ignoré par git).
#
# La clé de service, parce que tout ce dossier lit et écrit des tables
# fermées aux clients : empreintes, requêtes conservées, jeu d'évaluation.
# C'est une clé d'exploitant — elle ne quitte pas la machine de celui qui
# entraîne.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Le modèle de base à affiner. SigLIP par défaut : sa perte sigmoïde tient
# avec de petits lots, là où CLIP d'origine a besoin de grands lots pour
# fournir assez de négatifs (voir README).
MTC_BASE_MODEL=ViT-B-16-SigLIP
MTC_BASE_PRETRAINED=webli

# Nécessaire seulement pour comparer le modèle maison au modèle externe
# (`evaluate.py --compare`).
VOYAGE_API_KEY=
