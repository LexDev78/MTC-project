# Copier en `supabase/functions/.env` (gitignoré) et remplir.
#
# Clé du compte de service Firebase, encodée en base64 — c'est elle qui
# autorise l'envoi via l'API FCM v1.
#
# 1. Console Firebase → Paramètres du projet → Comptes de service →
#    « Générer une nouvelle clé privée » → télécharge un fichier .json
# 2. L'encoder sur une seule ligne :
#       base64 -i ~/Downloads/mtc-app-mali-xxxxx.json | tr -d '\n'
# 3. Coller le résultat ci-dessous.
#
# Base64 plutôt que le JSON brut parce que la clé privée qu'il contient est
# multi-ligne (PEM) — exactement ce qui se fait abîmer en passant par un
# shell, un parseur .env ou le champ « secret » du dashboard Supabase.
FCM_SERVICE_ACCOUNT_JSON_B64=

# Secret partagé entre le trigger en base et la fonction : il authentifie
# l'appel du webhook. Sans lui, n'importe qui pourrait appeler la fonction
# et pousser un texte arbitraire sur le téléphone de n'importe quel compte.
#
# En local, laisser la valeur ci-dessous : elle doit rester identique au
# repli codé dans `0042_push_webhook_dedicated_secret.sql`, et n'ouvre que
# la fonction servie localement.
#
# En production, générer une valeur forte et la poser aux DEUX endroits :
#       SECRET=$(openssl rand -hex 32)
#       supabase secrets set PUSH_WEBHOOK_SECRET="$SECRET"
#       supabase db query --linked "select vault.create_secret('$SECRET','push_function_secret');"
PUSH_WEBHOOK_SECRET=local-dev-push-secret

# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement
# par le runtime (en local comme en hébergé) — ne pas les mettre ici.

# Clé de l'API d'empreintes (Voyage AI), utilisée par `visual-search` et par
# l'indexation du catalogue. Facturée à l'appel : elle ne quitte jamais le
# serveur, et n'est donc **pas** une valeur à passer à l'app.
#
#   https://dash.voyageai.com → API Keys
#   supabase secrets set VOYAGE_API_KEY="..."
#
# Sans elle, la recherche par photo répond « indisponible » et l'indexation
# s'arrête — le reste de l'application fonctionne normalement.
VOYAGE_API_KEY=

# Secret qui autorise l'appel à `index-product-embeddings`. Elle parle au
# modèle, donc elle coûte de l'argent : seul l'exploitant (ou la tâche
# planifiée) doit pouvoir la déclencher.
#
#   SECRET=$(openssl rand -hex 32)
#   supabase secrets set INDEXING_SECRET="$SECRET"
INDEXING_SECRET=local-dev-indexing-secret
